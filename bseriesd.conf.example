# bseriesd configuration
#
# One "setting value" per line. Everything after a # is a comment. An unknown
# setting is an error rather than a silent no-op, so a typo cannot leave the
# server running with something other than what was intended.
#
#     bseriesd -c /etc/bseriesd.conf


# --- where to listen ------------------------------------------------------

listen                127.0.0.1     # use :: or 0.0.0.0 to accept remote connections
port                  8086


# --- the database ---------------------------------------------------------

data_directory        /var/lib/bseries
definitions           /etc/bseries.conf   # series interval and type declarations

# A table is a directory of series files under data_directory, giving each set of
# series its own key namespace. The table named "default" is data_directory
# itself, which is what keeps a database written before tables existed working
# without moving a file.
#
# Tables must be created through the API before they can be written to. Turn this
# on to have a write to an unknown table create it instead; off by default so a
# typo in a table name cannot quietly fork the data.

auto_create_tables    0

write_ahead_size      1024          # points per block; a block is always written whole
default_interval      10            # seconds per point for keys with no definition


# --- authentication -------------------------------------------------------
#
# Keys can be managed entirely over HTTP and none need be set here. Start the
# server with no keys and it prints a one time bootstrap token; POST that to
# /v1/auth/keys to mint the first write key, and everything else follows from
# there. Minted keys are kept salted and hashed in the keystore below.
#
# keystore defaults to auth.keys in the data directory.

# keystore            /var/lib/bseries/auth.keys

# Static keys, the way this worked before keys could be minted over HTTP. They
# still work and sit alongside the keystore. Presented as X-API-Key: <key>
# (Authorization: Bearer <key> also works). read_key may call the GET endpoints;
# write_key may call everything. They must differ.
#
# Unlike minted keys these are stored in the clear, so prefer minting. If you do
# set them, chmod 600 this file; bseriesd warns on startup if other users can
# read it.

# read_key            CHANGE_ME_read_only_key
# write_key           CHANGE_ME_read_write_key


# --- CORS -----------------------------------------------------------------
#
# Origins allowed to call the API from a browser. Repeat the setting for more
# than one. A single entry of * allows any origin. With no cors_origin line no
# CORS headers are sent at all, which blocks browser callers; that is the right
# default when the only clients are server side.

# cors_origin         https://dashboard.example.com
# cors_origin         http://localhost:3000


# --- limits ---------------------------------------------------------------

# max_points_per_read is a budget for a whole request, not per series, so that
# asking for more series in one call cannot multiply it.
#
# Read responses are streamed, so a request no longer holds its whole answer in
# memory. Peak is one series' points plus a 64KB buffer, not the size of the
# response, which is what makes a large limit here affordable.

max_points_per_read   1000000       # a wider raw range is refused with 413
max_series_per_read   500           # keys= may name at most this many series

# Condensed reads (max_points + condense) are windowed rather than read whole,
# so they are not bounded by max_points_per_read. max_condense_scan bounds how
# many stored slots one condensed request may walk, and condense_window how many
# are held in memory at a time while doing it.

max_condense_scan     50000000
condense_window       262144
max_points_per_write  500000        # total points one write request may carry
max_body_bytes        1048576       # a larger request body is refused with 413
max_connections       64            # further connections get 503

# Series are dense, so a point timestamped far beyond the end of a series null
# fills every interval in between. This bounds how far one write may reach;
# beyond it the write fails rather than allocating and writing gigabytes for a
# single bad timestamp.

max_grow_points       1000000


# --- maintenance ----------------------------------------------------------
#
# flush_interval bounds how long a point may sit in memory before reaching the
# disk, in seconds. The write ahead buffer holds a number of points rather than a
# span of time, so on a 60 second series an actively written buffer can hold
# nearly three days of data; this is what turns that into a number you can state.
# A flush writes only the points actually buffered, so an early flush is cheap and
# later writes stay buffered. 0 disables the timer. SIGTERM and SIGINT flush
# everything regardless, so a clean restart never loses points.
#
# A series untouched for series_max_idle seconds is flushed and dropped from
# memory, so the server does not keep a buffer for every key it has ever touched.
# Note that eviction only catches idle series; flush_interval is what covers the
# busy ones. Set either to 0 to disable it.
#
# All three can be changed while the server runs, through POST /v1/config.

flush_interval        60
series_max_idle       900
maintenance_interval  60
